# Copy to .env for local development.

# --- Database ---------------------------------------------------------------
# A Postgres connection string. A free instance from https://neon.tech works
# well for both local dev and a small production deployment (e.g. Vercel).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Stripe (payment portal) -------------------------------------------------
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# When unset, checkout falls back to a simulated instant-pay flow so the
# wizard is fully clickable in local dev without live Stripe keys. NEVER
# leave this on in production.
DEV_FAKE_PAYMENTS="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OnlinePlanService integration -------------------------------------------
# Mode "mock" (default) uses seeded local data so the app runs standalone.
# Mode "live" calls the real OnlinePlanService API using the credentials below.
OPS_API_MODE="mock"
OPS_API_BASE_URL="https://api.onlineplanservice.com"
OPS_API_KEY=""
